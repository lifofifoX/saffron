{
  "name": "saffron",
  "private": true,
  "version": "0.1.0",
  "description": "A self custody vault for Bitcoin Ordinals",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "node scripts/check-hardcoded-colors.mjs",
    "format": "prettier --write 'src/**/*.{ts,js,svelte,json,css}'",
    "test:unit": "vitest run",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:signatures": "npm audit signatures",
    "security:install-state": "node scripts/check-install-state.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ledgerhq/hw-transport-webusb": "^6.35.0",
    "@ledgerhq/ledger-bitcoin": "^0.3.1",
    "@noble/curves": "~2.2.0",
    "@noble/hashes": "~2.2.0",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.2.0",
    "@scure/btc-signer": "^2.2.0",
    "@trezor/connect-web": "^9.7.3",
    "bits-ui": "^2.18.1",
    "buffer": "6.0.3",
    "sats-connect": "^4.2.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "axios": "1.19.0",
    "protobufjs": "7.6.5",
    "valibot": "1.4.2"
  }
}
